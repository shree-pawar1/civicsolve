# CivicSolve Environment Variables Template
# Copy this file to .env or backend/.env

NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicsolve?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicsolve_test?schema=public"

# Session Security
SESSION_SECRET="replace-with-a-secure-random-64-char-string-in-production"
SESSION_COOKIE_NAME="civic_session"

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN="http://localhost:5173"

# Optional AI Analysis (Backend only)
# GEMINI_API_KEY=""
